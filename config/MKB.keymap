// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cmd+t {
            bindings = <&kp LG(T)>;
            key-positions = <5 4>;
        };

        cmd+n {
            bindings = <&kp LG(N)>;
            key-positions = <30 31>;
        };

        cmd+option+u {
            bindings = <&kp LA(LG(U))>;
            key-positions = <6 7>;
        };

        cmd+shift+v {
            bindings = <&kp LG(LS(V))>;
            key-positions = <29 28>;
        };

        cmd+w {
            bindings = <&kp LG(W)>;
            key-positions = <1 2>;
        };

        cmd+g {
            bindings = <&kp LG(F)>;
            key-positions = <17 16>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp Q        &kp W     &kp E      &kp R                &kp T        &kp ESCAPE               &kp AT_SIGN    &kp Y          &kp U      &kp I      &kp O       &kp P
&kp A        &kp S     &kp D      &kp F                &kp G        &kp TAB                  &kp MINUS      &kp H          &kp J      &kp K      &kp L       &kp MINUS
&mt LSHFT Z  &kp X     &kp C      &kp V                &kp B        &kp EXCLAMATION          &kp QUESTION   &kp N          &kp M      &kp COMMA  &kp PERIOD  &lt 5 PERIOD
&kp LCTRL    &kp LALT  &kp LSHFT                       &lt 4 SPACE  &lt FUNC LANGUAGE_1      &kp BACKSPACE  &lt NUM ENTER             &mkp MB1   &mkp MB2    &kp COMMA
&kp LEFT     &kp UP    &kp LANG1  &kp DOWN             &kp RIGHT                                            &kp HOME       &kp PG_UP  &kp ENTER  &kp PG_DN   &kp END
                                  &mt LGUI LANGUAGE_2                                                                      &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_UP PAGE_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&trans    &kp F2  &kp LA(LC(LEFT))  &kp LC(LA(RIGHT))  &kp F4         &trans      &trans      &kp F1                &kp F10           &trans         &trans                &trans
&trans    &trans  &trans            &trans             &kp SEMICOLON  &trans      &trans      &kp LEFT_BRACE        &kp RIGHT_BRACE   &kp SQT        &kp LG(LS(DOWN))      &trans
&trans    &trans  &trans            &trans             &kp TILDE      &trans      &trans      &kp LESS_THAN         &kp GREATER_THAN  &kp LG(LS(D))  &kp LS(LG(NUMBER_4))  &kp LG(LS(NUMBER_5))
&trans    &trans  &kp LS(NUMBER_2)                     &trans         &trans      &kp DELETE  &kp ENTER                               &trans         &trans                &trans
&kp LEFT  &kp UP  &kp SPACE         &kp DOWN           &kp RIGHT                              &kp LG(LEFT_BRACKET)  &kp C_VOLUME_UP   &kp ENTER      &kp C_VOLUME_DOWN     &kp LG(RIGHT_BRACKET)
                                    &kp EQUAL                                                                       &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&kp TAB           &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp MINUS             &trans             &trans     &kp LC(LEFT)           &kp LC(RIGHT)  &kp LC(UP_ARROW)  &kp LC(DOWN)  &kp LG(LC(LS(Z)))
&kp NUMBER_0      &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp COLON             &trans             &trans     &kp LG(RIGHT_BRACKET)  &kp AT_SIGN    &kp UP_ARROW      &kp COMMA     &trans
&mt LSHIFT SLASH  &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp NON_US_BACKSLASH  &trans             &trans     &kp LG(LEFT_BRACKET)   &kp LEFT       &kp DOWN          &kp RIGHT     &kp PAGE_UP
&kp LCTRL         &kp LSHIFT    &kp LALT                     &kp LG(LC(R))         &kp LC(LS(S))      &kp ENTER  &kp ENTER                             &trans            &trans        &kp PAGE_DOWN
&kp LC(LEFT)      &kp LC(UP)    &kp LC(LG(F))  &kp LC(DOWN)  &kp LC(RIGHT)                                       &kp HOME               &kp PG_UP      &kp ENTER         &kp PG_DN     &kp END
                                               &kp LGUI                                                                                 &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp LS(LEFT) LS(RIGHT)>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB3  &mkp MB1   &mkp MB2   &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_UP PAGE_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&kp ESCAPE       &kp F2             &kp LC(LA(LEFT))  &kp LC(LA(RIGHT))     &kp PIPE               &trans             &trans         &kp LA(LC(D))     &kp LA(LC(E))      &kp LC(LA(F))     &kp LC(LA(T))     &kp LA(LC(G))
&kp TAB          &kp DOUBLE_QUOTES  &kp AMPERSAND     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans             &trans         &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE  &kp LG(LS(DOWN))  &kp LC(LA(ENTER))
&mt LSHIFT HASH  &kp PLUS           &kp EXCLAMATION   &kp QUESTION          &kp TILDE              &kp LG(LS(V))      &kp LA(LG(V))  &kp LG(A)         &kp LG(C)          &kp LG(V)         &kp LC(Q)         &kp LG(PLUS)
&kp LCTRL        &trans             &kp AT_SIGN                             &trans                 &trans             &kp DELETE     &trans                               &trans            &trans            &trans
&kp LEFT         &kp UP             &kp SPACE         &kp DOWN              &kp RIGHT                                                &kp LS(LC(TAB))   &kp LG(R)          &kp ENTER         &mkp MB3          &kp LC(TAB)
                                                      &kp EQUAL                                                                                        &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp LG(TAB) LS(LG(TAB))>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR            &bt BT_SEL 0  &trans     &kp LG(LA(MINUS))  &kp LG(LA(LS(EQUAL)))  &trans      &bt BT_CLR_ALL  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans                &trans        &trans     &kp LS(F11)        &kp LS(LA(S))          &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans                &trans        &trans     &trans             &trans                 &trans      &trans          &trans        &trans        &trans        &trans        &trans
&trans                &trans        &trans                        &trans                 &trans      &trans          &trans                      &trans        &trans        &trans
&kp LG(LA(UP_ARROW))  &kp UP        &kp SPACE  &kp DOWN           &kp LG(LA(DOWN))                                   &kp HOME      &kp PG_UP     &kp ENTER     &kp PG_DN     &kp END
                                               &kp A                                                                               &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp LC(LS(TAB)) LC(TAB)>,
                <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
